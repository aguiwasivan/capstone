SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase PostgreSQL connection. Use the Session Pooler or direct database URL from Supabase.
DATABASE_URL=

# Supabase Storage. Never put the service role key in the React frontend.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=blueprints

# AI vision analysis. AI_API_KEY can use the same value as OPENAI_API_KEY.
AI_API_KEY=
AI_VISION_MODEL=gpt-4o-mini

# Optional OpenAI image/text settings used by other app features.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4o-mini
