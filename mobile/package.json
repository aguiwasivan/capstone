{
  "name": "reservation-portal-android",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo": "^58.0.0",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo start --android --port 8082",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsc -p tsconfig.tests.json && node --test tests/*.test.cjs",
    "test:backend": "..\\backend\\venv\\Scripts\\python.exe scripts/check_backend.py",
    "export:android": "expo export --platform android",
    "start:tunnel": "expo start --port 8082 --tunnel ngrok --clear",
    "start:phone": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start_phone.ps1"
  },
  "private": true
}
